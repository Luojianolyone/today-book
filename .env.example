# ============================================
# Today Book — 环境变量配置模板
# 复制此文件为 .env 并修改对应值
# ============================================

# ---------- 数据库 ----------
# SQLite（默认）
DATABASE_URL=sqlite:///./data/app.db
# PostgreSQL（生产环境推荐）
# DATABASE_URL=postgresql://user:password@localhost:5432/todaybook

# ---------- 安全 ----------
# 生产环境必须修改为随机长字符串（至少 32 字符）
SECRET_KEY=your-secret-key-here-minimum-32-characters-long

# ---------- JWT ----------
# 加密算法，默认 HS256
ALGORITHM=HS256
# Token 过期天数，默认 30 天
ACCESS_TOKEN_EXPIRE_DAYS=30

# ---------- CORS ----------
# 允许的前端来源，多个用逗号分隔
CORS_ORIGINS=http://localhost:3003,http://localhost:5173

# ---------- 文件上传 ----------
# 上传文件存储目录
UPLOAD_DIR=./uploads
# 最大上传文件大小（字节），默认 50MB
MAX_UPLOAD_SIZE=52428800
